generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EmployeeStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
  HYBRID
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  ON_LEAVE
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  setupTokenHash String?
  setupTokenExpiresAt DateTime?
  status       UserStatus @default(ACTIVE)

  employee      Employee?
  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  devices      SecurityDevice[]
  configuredOffices Office[] @relation("OfficeNetworkConfigurator")
  replacementRequests DeviceReplacementRequest[]
  notifications Notification[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Department {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  headEmployeeId String? @unique
  headEmployee Employee? @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)

  employees Employee[]
  chatMessages DepartmentMessage[]
  tasks DepartmentTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Position {
  id          String  @id @default(uuid())
  title       String  @unique
  description String?
  isActive    Boolean @default(true)

  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id String @id @default(uuid())

  employeeNumber String @unique

  firstName  String
  lastName   String
  middleName String?

  email       String?   @unique
  phone       String?
  dateOfBirth DateTime?
  birthdayNotificationYear Int?
  workAnniversaryNotificationYear Int?

  gender  String?
  address String?

  profilePhoto String?

  employmentType   EmploymentType @default(FULL_TIME)
  employmentStatus EmployeeStatus @default(PROBATION)

  dateJoined       DateTime
  employmentMonthYear String?
  confirmationDate DateTime?
  grossSalary Decimal? @db.Decimal(14, 2)
  lastSalary Decimal? @db.Decimal(14, 2)
  reviewDate DateTime?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  positionId String?
  position   Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  officeId String?
  office Office? @relation(fields: [officeId], references: [id], onDelete: SetNull)

  managerId String?
  manager   Employee? @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)

  directReports Employee[] @relation("EmployeeManager")
  headedDepartment Department? @relation("DepartmentHead")
  sentDepartmentMessages DepartmentMessage[] @relation("DepartmentMessageSender")
  assignedDepartmentTasks DepartmentTask[] @relation("DepartmentTaskAssignee")
  createdDepartmentTasks DepartmentTask[] @relation("DepartmentTaskCreator")
  personalInformation EmployeePersonalInformation?
  payrollConfiguration PayrollConfiguration?
  monthlyPayrollDeductions MonthlyPayrollDeduction[]
  payrollPayslips PayrollPayslip[]

  attendance                   Attendance[]
  handbookArticles            HandbookArticle[]          @relation("HandbookArticleAuthor")
  leaveBalances                LeaveBalance[]
  leaveRequests                Leave[]
  leaveApprovals               Leave[]                    @relation("LeaveApprover")
  performanceReviews           PerformanceReview[]
  reviewedPerformanceReviews   PerformanceReview[]        @relation("PerformanceReviewReviewer")
  createdCelebrations          Celebration[]
  birthdayWishesSent           BirthdayWish[] @relation("BirthdayWishSender")
  birthdayWishesReceived       BirthdayWish[] @relation("BirthdayWishRecipient")
  notifications               Notification[]
  performedAuditLogs          AuditLog[]                 @relation("AuditLogActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeNumber])
  @@index([email])
  @@index([departmentId])
  @@index([positionId])
  @@index([managerId])
  @@index([employmentStatus])
  @@index([officeId])
}

model Office {
  id String @id @default(uuid())
  name String
  code String @unique
  address String
  isActive Boolean @default(true)
  approvedNetworks String[] @default([])
  networkConfiguredAt DateTime?
  configuredById String?
  configuredBy User? @relation("OfficeNetworkConfigurator", fields: [configuredById], references: [id], onDelete: SetNull)
  employees Employee[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isActive])
}

model SecuritySettings {
  id String @id @default("global")
  attendanceOfficeEnforcement Boolean @default(false)
  updatedAt DateTime @updatedAt
}

model SecurityDevice {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialHash String @unique
  label String?
  userAgent String?
  lastIpAddress String?
  lastUsedAt DateTime @default(now())
  revokedAt DateTime?
  createdAt DateTime @default(now())
  refreshTokens RefreshToken[]
  replacementRequests DeviceReplacementRequest[] @relation("ReplacementTargetDevice")
  @@index([userId, revokedAt])
}

model DeviceReplacementRequest {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId String
  device SecurityDevice @relation("ReplacementTargetDevice", fields: [deviceId], references: [id], onDelete: Cascade)
  reason String
  status String @default("PENDING")
  reviewedByUserId String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  @@index([status, createdAt])
  @@index([userId])
}

model SecurityEvent {
  id String @id @default(uuid())
  userId String?
  userEmail String?
  eventType String
  outcome String
  reason String?
  ipAddress String?
  details Json?
  createdAt DateTime @default(now())
  @@index([eventType, createdAt])
  @@index([userId, createdAt])
}

model DepartmentMessage {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  senderId     String
  sender       Employee   @relation("DepartmentMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  message      String
  createdAt    DateTime   @default(now())

  @@index([departmentId, createdAt])
}

enum DepartmentTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

model DepartmentTask {
  id           String               @id @default(uuid())
  departmentId String
  department   Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  assignedById String?
  assignedBy   Employee?            @relation("DepartmentTaskCreator", fields: [assignedById], references: [id], onDelete: SetNull)
  assigneeId   String
  assignee     Employee             @relation("DepartmentTaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  dueDate      DateTime?
  status       DepartmentTaskStatus @default(OPEN)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([departmentId, status])
  @@index([assigneeId, status])
}

model EmployeePersonalInformation {
  id         String   @id @default(uuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  data       Json
  proposedData Json?
  reviewBaseData Json?
  reviewStatus String  @default("PENDING")
  reviewComment String?
  reviewedAt DateTime?
  submittedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

}

model PayrollConfiguration {
  id         String   @id @default(uuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  basicSalary Decimal @db.Decimal(14, 2)
  benefits   Json     @default("[]")
  customAdditions Json @default("[]")
  deductions Json     @default("[]")
  currency   String   @default("NGN")
  isEnabled  Boolean  @default(true)
  updatedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isEnabled])
}

model PayrollCurrencyOption {
  code      String   @id
  createdAt DateTime @default(now())
}

model MonthlyPayrollDeduction {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period     String
  deductions Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, period])
  @@index([period])
}

model PayrollStandardComponent {
  id String @id @default(uuid())
  name String @unique
  percentage Decimal @db.Decimal(5, 2)
  sortOrder Int @default(0)
  updatedAt DateTime @updatedAt
}

model PayrollPayslip {
  id             String    @id @default(uuid())
  employeeId     String?
  employee       Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeName   String
  employeeNumber String
  recipientEmail String
  recipientEmails String[] @default([])
  period         String
  currency       String    @default("NGN")
  basicSalary    Decimal   @db.Decimal(14, 2)
  benefits       Json
  grossPay       Decimal   @db.Decimal(14, 2)
  deductions     Json
  totalDeductions Decimal  @db.Decimal(14, 2)
  netPay         Decimal   @db.Decimal(14, 2)
  emailedAt      DateTime?
  emailSendingAt DateTime?
  emailError     String?
  emailAttempts  Int       @default(0)
  createdAt      DateTime  @default(now())

  @@unique([employeeId, period])
  @@index([period])
  @@index([recipientEmail])
}

model Attendance {
  id String @id @default(uuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  attendanceDate DateTime

  clockIn  DateTime?
  clockOut DateTime?

  status AttendanceStatus @default(PRESENT)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, attendanceDate])
  @@index([employeeId])
  @@index([attendanceDate])
  @@index([status])
}

enum AppraisalCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum AppraisalStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

model AppraisalCycle {
  id          String              @id @default(uuid())
  name        String
  year        Int
  startDate   DateTime
  endDate     DateTime
  description String?
  status      AppraisalCycleStatus @default(DRAFT)

  performanceReviews PerformanceReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year])
  @@index([status])
}

model PerformanceReview {
  id String @id @default(uuid())

  cycleId String
  cycle   AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  reviewerId String?
  reviewer   Employee? @relation("PerformanceReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  title             String?
  selfAssessment    String?
  managerAssessment String?
  strengths        String?
  improvementAreas String?
  goals            String?
  overallRating    Float?

  status      AppraisalStatus @default(DRAFT)
  submittedAt DateTime?
  reviewedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cycleId, employeeId])
  @@index([cycleId])
  @@index([employeeId])
  @@index([reviewerId])
  @@index([status])
}

enum CelebrationType {
  BIRTHDAY
  WORK_ANNIVERSARY
  TEAM_ACHIEVEMENT
  COMPANY_EVENT
  HOLIDAY
  RECOGNITION
  OTHER
}

model Celebration {
  id String @id @default(uuid())

  title       String
  type        CelebrationType @default(OTHER)
  description String?
  eventDate   DateTime?
  location    String?
  imageUrl    String?
  isPublished Boolean        @default(true)

  createdById String?
  createdBy   Employee? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isPublished])
  @@index([eventDate])
}

model BirthdayWish {
  id          String   @id @default(uuid())
  senderId    String
  sender      Employee @relation("BirthdayWishSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   Employee @relation("BirthdayWishRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  celebrationType CelebrationType @default(BIRTHDAY)
  message     String
  createdAt   DateTime @default(now())

  @@index([recipientId, createdAt])
  @@index([senderId])
}

model HandbookArticle {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  summary     String?
  category    String
  content     String
  isPublished Boolean  @default(false)
  publishedAt DateTime?

  createdById String?
  createdBy   Employee? @relation("HandbookArticleAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  attachments PolicyAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isPublished, publishedAt])
  @@index([createdById])
}

model PolicyAttachment {
  id         String          @id @default(uuid())
  articleId  String
  article    HandbookArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  fileName   String
  storageKey String          @unique
  mimeType   String
  size       Int
  createdAt  DateTime        @default(now())

  @@index([articleId])
}

enum LeaveType {
  ANNUAL
  SICK
  EMERGENCY
  MATERNITY
  PATERNITY
  STUDY
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  ANNOUNCEMENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  ASSIGN
  EXPORT
}

model Notification {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  title    String
  message  String
  type     NotificationType @default(INFO)
  isRead   Boolean         @default(false)
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([employeeId])
  @@index([isRead])
}

model AuditLog {
  id String @id @default(uuid())

  actorId String?
  actor   Employee? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  entityType String
  entityId   String?
  action     AuditAction
  details    String?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([userId])
  @@index([entityType])
  @@index([action])
}

model LeaveBalance {
  id String @id @default(uuid())

  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  annualDays         Float @default(21)
  sickDays           Float @default(12)
  carriedForwardDays Float @default(0)
  usedDays           Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

model Leave {
  id String @id @default(uuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  approverId String?
  approver   Employee? @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)

  leaveType LeaveType @default(ANNUAL)
  startDate DateTime
  endDate   DateTime
  days      Float
  reason    String

  status LeaveStatus @default(PENDING)

  approvalComment String?
  rejectionReason String?

  requestedAt DateTime  @default(now())
  reviewedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@index([approverId])
}

model RefreshToken {
  id String @id @default(uuid())

  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId String?
  device SecurityDevice? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
