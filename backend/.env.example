NODE_ENV=development

PORT=5000

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/fluide_hrm"

JWT_ACCESS_SECRET="replace_with_long_random_secret"
JWT_REFRESH_SECRET="replace_with_another_long_random_secret"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

FRONTEND_URL="http://localhost:5173"

# Comma-separated trusted reverse-proxy IPs/CIDRs. Leave empty unless verified for the host.
TRUSTED_PROXY_IPS=""

SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Fluidé Homes Workspace <hello@fluidehomes.com>"
